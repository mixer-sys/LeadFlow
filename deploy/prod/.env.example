# Deployment
IMAGE_TAG=latest

# HTTP
HTTP_ADDR=:8080

# PostgreSQL
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=leadflow

DB_HOST=postgres
DB_PORT=5432
DB_USER=leadflow
DB_PASSWORD=change-me-strong-password
DB_NAME=leadflow
DB_SSLMODE=require

# Redis
REDIS_ADDR=redis:6379

# LeadFlow API
API_KEY=change-me-api-key
GRPC_INTERNAL_TOKEN=change-me-grpc-token

# Telegram
TELEGRAM_BOT_TOKEN=change-me-telegram-token
TELEGRAM_CHAT_ID=123456789

# Bitrix24
BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/xxxx/

# Observability
LOG_LEVEL=info
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317